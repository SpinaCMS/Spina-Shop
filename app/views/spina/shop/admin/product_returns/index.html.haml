%header#header
  .breadcrumbs
    = render_breadcrumbs separator: '<div class="divider"></div>'
        
.table-container.infinite-table
  %table.table
    %thead
      %tr
        %th Nummer
        %th Bestelling
        %th Aangemaakt op
        %th.text-right Producten
        %th Status
        %th.text-right
  
    %tbody
      = render collection: @product_returns, partial: "product_return"
      
  - next_page_params = request.query_parameters.merge('page' => [params[:page].to_i, 1].max + 1)
  .pagination= link_to 'Next', spina.shop_admin_product_returns_path(next_page_params), rel: 'next'