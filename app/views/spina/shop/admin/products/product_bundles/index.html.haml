- content_for :header_actions do
  = link_to spina.new_shop_admin_product_bundle_path, class: 'button button-mini icon-only' do
    %i.icon.icon-plus{style: 'vertical-align: bottom'}
    
.table-container.infinite-table
  %table.table.table-clickable
    %thead
      %tr
        %th Bundel
        %th Inhoud
        %th.text-right Verkocht
        %th.text-right Prijs
        %th{style: 'width: 50px'}

    %tbody= render partial: 'product_bundle', collection: @product_bundles
              
  - next_page_params = request.query_parameters.merge('page' => [params[:page].to_i, 1].max + 1)
  .pagination= link_to 'Next', spina.shop_admin_product_bundles_path(next_page_params), rel: 'next'